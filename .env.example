# Sao chép file này thành .env rồi sửa theo ý bạn:  cp .env.example .env

# Cổng chạy app
PORT=3000

# Tên app (hiện trên màn hình chính điện thoại và tiêu đề)
APP_NAME=Think

# Tên phòng chat chung của cả nhóm (chỉ dùng khi tạo database lần đầu)
GENERAL_ROOM_NAME=Cả nhóm

# Tài khoản admin đầu tiên (chỉ dùng khi database còn trống)
ADMIN_USERNAME=admin
# Để trống: app tự tạo mật khẩu ngẫu nhiên và in ra log, đăng nhập xong phải đổi
ADMIN_PASSWORD=

# Quên mật khẩu admin: điền mật khẩu mới vào đây, khởi động lại, đăng nhập xong thì xóa dòng này
# RESET_ADMIN_PASSWORD=

# Email liên hệ cho dịch vụ thông báo đẩy. Nên dùng email thật (iPhone khó tính với email giả)
VAPID_SUBJECT=mailto:ban@example.com

# Thư mục lưu database, ảnh và khóa thông báo. NHỚ SAO LƯU THƯ MỤC NÀY.
# DATA_DIR=./data

# Sao lưu lên Firebase Firestore (dùng cho Render Free). Dán nguyên nội dung file khóa .json
# FIREBASE_SERVICE_ACCOUNT=

# App Android (APK từ PWABuilder): thay vì chép data/assetlinks.json, có thể điền 2 dòng này
# ANDROID_PACKAGE=com.tenban.think
# ANDROID_SHA256=AA:BB:CC:...   (nhiều mã thì cách nhau bằng dấu phẩy)

# Chạy sau proxy ở máy khác (Railway, Fly...) thì đặt 1. Render được tự nhận.
# Mặc định chỉ tin proxy chạy cùng máy (Caddy, Nginx, cloudflared)
# TRUST_PROXY=1
