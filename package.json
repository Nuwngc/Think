{
  "name": "think-chat",
  "version": "2.5.0",
  "private": true,
  "description": "Web chat PWA cho hội bạn: tài khoản do admin cấp, thông báo đẩy, đổi tên / mật khẩu / ảnh đại diện",
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "test": "node --test test/*.test.js",
    "share": "node scripts/tunnel.js --with-server",
    "tunnel": "node scripts/tunnel.js",
    "admin": "node scripts/admin.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "js-chess-engine": "^2.4.6",
    "socket.io": "^4.8.4",
    "stockfish": "^11.0.0",
    "web-push": "^3.6.7"
  }
}
